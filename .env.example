# ===== DeepSeek（LLM 生成）=====
DEEPSEEK_API_KEY=sk-你的deepseek密钥

# ===== 硅基流动（embedding，bge-m3）=====
SILICONFLOW_API_KEY=sk-你的硅基流动密钥

# ===== 可选配置（有默认值，不需要可以不写）=====
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=zh
# WHISPER_BATCH_SIZE=4  # 0 使用原逐段模式
# BILI_AUDIO_MAX_MIB=50
# CHUNK_TARGET_CHARS=400
# CHUNK_OVERLAP_CHARS=50
# TOP_K=5

# ===== 可选：音视频理解实验（本地 .env，勿提交真实密钥）=====
# GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-3.8-flash
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=cn-beijing
# VIDEO_DELETE_ORIGINS=https://你的前端地址
# 临时开启检索逐阶段日志（含问题和核验摘要，不输出完整切片或密钥）。
RAG_RETRIEVAL_DIAGNOSTICS=0
